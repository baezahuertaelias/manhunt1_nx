 extern RECOMP_TLS uint32_t g_mxcsr;
+
+/* LDMXCSR. Flush-to-zero (bit 15) and denormals-are-zero (bit 6) change
+ * results, so they reach the host: RenderWare's SSE setup sets FTZ, and its
+ * normalize relies on it. A tiny vector's squared length flushes to zero and
+ * the masked rsqrt gives a zero vector; kept as a denormal it gives
+ * 0 * inf = NaN (Manhunt's hunter position). AArch64 FPCR.FZ (bit 24) flushes
+ * both inputs and outputs; it is per thread, as MXCSR is. */
+static inline void recomp_ldmxcsr(uint32_t value) {
+    g_mxcsr = value;
+    int flush = (value & 0x8040u) != 0;
+#if defined(__aarch64__)
+    uint64_t fpcr;
+    __asm__ volatile("mrs %0, fpcr" : "=r"(fpcr));
+    uint64_t want = flush ? (fpcr | (1ull << 24)) : (fpcr & ~(1ull << 24));
+    if (want != fpcr) __asm__ volatile("msr fpcr, %0" : : "r"(want));
+#elif defined(_M_IX86) || defined(_M_X64) || defined(__i386__) || defined(__x86_64__)
+    _mm_setcsr((_mm_getcsr() & ~0x8040u) | (value & 0x8040u));
+#else
+    (void)flush;
+#endif
+}
