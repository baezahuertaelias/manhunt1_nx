+    /* Every hardware CLUT length accepts its last index and rejects the next. */
+    {
+        const uint32_t counts[] = {32, 64, 128};
+        Nv2aTexture tex = {.offset=0x1000, .width=2, .height=2, .color=0x0B,
+                          .palette_va=0xA000};
+        uint32_t decoded[4];
+        Nv2aTexture before = s_be.texture;
+        unsigned n;
+        for (n = 0; n < sizeof counts / sizeof counts[0]; n++) {
+            tex.palette_entries = counts[n];
+            s_mem[0x1000] = 0; s_mem[0x1001] = 1;
+            s_mem[0x1002] = 2; s_mem[0x1003] = counts[n] - 1;
+            put32(0xA000 + 4*(counts[n]-1), 0xA137C95Bu);
+            CHECK(nv2a_backend_decode_texture(&tex, decoded));
+            CHECK(decoded[3] == 0xA137C95Bu);
+            put32(0xA000 + 4*(counts[n]-1), 0x001257E3u);
+            CHECK(nv2a_backend_decode_texture(&tex, decoded));
+            CHECK(decoded[3] == 0x001257E3u);
+            s_mem[0x1003] = counts[n];
+            CHECK(!nv2a_backend_decode_texture(&tex, decoded));
+            /* A subsequent full-palette decode still accepts the larger index. */
+            tex.palette_entries = 256;
+            CHECK(nv2a_backend_decode_texture(&tex, decoded));
+        }
+        tex.palette_entries = 16; CHECK(!nv2a_backend_decode_texture(&tex, decoded));
+        tex.palette_entries = 0; CHECK(!nv2a_backend_decode_texture(&tex, decoded));
+        tex.palette_entries = 33; CHECK(!nv2a_backend_decode_texture(&tex, decoded));
+        m(0x17FC, 5); m(0x1810, 2u << 24); m(0x17FC, 0);
+        CHECK(s_be.textured && !memcmp(&before, &s_be.texture, sizeof before));
+    }
