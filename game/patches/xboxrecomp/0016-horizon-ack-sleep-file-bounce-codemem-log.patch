+/* Horizon (patch 0016): guest RAM is a code-memory view. File-system IPC
+ * buffers there are untested on a real console (they work in Eden), so file
+ * data goes through a plain heap buffer in 64 KiB pieces and is copied. */
+static ssize_t nx_read_bounce(int fd, void *dst, size_t len)
+{
+    enum { CHUNK = 65536 };
+    size_t done = 0;
+    size_t cap = len < CHUNK ? len : CHUNK;
+    char *tmp = cap ? (char *)malloc(cap) : NULL;
+    if (!tmp)
+        return len ? -1 : 0;
+    while (done < len) {
+        size_t want = len - done < cap ? len - done : cap;
+        ssize_t r = read(fd, tmp, want);
+        if (r < 0) {
+            if (done)
+                break;
+            free(tmp);
+            return -1;
+        }
+        if (r == 0)
+            break;
+        memcpy((char *)dst + done, tmp, (size_t)r);
+        done += (size_t)r;
+        if ((size_t)r < want)
+            break;
+    }
+    free(tmp);
+    return (ssize_t)done;
+}
+
+static ssize_t nx_write_bounce(int fd, const void *src, size_t len)
+{
+    enum { CHUNK = 65536 };
+    size_t done = 0;
+    size_t cap = len < CHUNK ? len : CHUNK;
+    char *tmp = cap ? (char *)malloc(cap) : NULL;
+    if (!tmp)
+        return len ? -1 : 0;
+    while (done < len) {
+        size_t want = len - done < cap ? len - done : cap;
+        memcpy(tmp, (const char *)src + done, want);
+        ssize_t w = write(fd, tmp, want);
+        if (w < 0) {
+            if (done)
+                break;
+            free(tmp);
+            return -1;
+        }
+        if (w == 0)
+            break;
+        done += (size_t)w;
+        if ((size_t)w < want)
+            break;
+    }
+    free(tmp);
+    return (ssize_t)done;
 }
+#define NX_READ(fd, buf, len)  nx_read_bounce((fd), (buf), (len))
+#define NX_WRITE(fd, buf, len) nx_write_bounce((fd), (buf), (len))
+#else
+#define NX_READ(fd, buf, len)  read((fd), (buf), (len))
+#define NX_WRITE(fd, buf, len) write((fd), (buf), (len))
+#endif
 
