+/* MANHUNT_LANGUAGE: the EEPROM language the title sees. Xbox values: 1 English,
+ * 2 Japanese, 3 German, 4 French, 5 Spanish, 6 Italian. Accepts the number or
+ * the English/native name; unset or unknown keeps English. */
+static ULONG xbox_eeprom_language(void)
+{
+    static const struct { const char *name; ULONG v; } tab[] = {
+        {"english", 1}, {"japanese", 2}, {"german", 3}, {"deutsch", 3},
+        {"french", 4}, {"francais", 4}, {"spanish", 5}, {"espanol", 5},
+        {"italian", 6}, {"italiano", 6},
+    };
+    const char *e = getenv("MANHUNT_LANGUAGE");
+    char low[16];
+    size_t i;
+    if (!e || !*e)
+        return 1;
+    if (e[0] >= '1' && e[0] <= '6' && !e[1])
+        return (ULONG)(e[0] - '0');
+    for (i = 0; e[i] && i < sizeof low - 1; i++)
+        low[i] = (char)((e[i] >= 'A' && e[i] <= 'Z') ? e[i] + 32 : e[i]);
+    low[i] = 0;
+    for (i = 0; i < sizeof tab / sizeof tab[0]; i++)
+        if (!strcmp(low, tab[i].name))
+            return tab[i].v;
+    return 1;
+}
