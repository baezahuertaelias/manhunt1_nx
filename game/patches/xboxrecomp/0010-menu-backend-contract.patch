+/* Programs are assembled from documented fields, not title-specific words. */
+static unsigned input(unsigned reg, int alpha, unsigned mapping)
+{ return reg | (alpha ? 16u : 0) | (mapping << 5); }
+static unsigned inputs(unsigned a, unsigned b, unsigned c, unsigned d)
+{ return (a << 24) | (b << 16) | (c << 8) | d; }
+static Nv2aCombiner program(int texture, int swapped, int sum_output, int final)
+{
+    Nv2aCombiner rc = {0};
+    unsigned part;
+    rc.control = 1; rc.stage_program = texture ? 1 : 0;
+    for (part = 0; part < 2; part++) {
+        unsigned a = input(4, part, 0);
+        unsigned b = texture ? input(8, part, 0) : input(0, part, 1);
+        unsigned icw = inputs(swapped ? b : a, swapped ? a : b, 0, 0);
+        unsigned ocw = 12u << (sum_output ? 8 : 4);
+        if (part) { rc.alpha_icw[0] = icw; rc.alpha_ocw[0] = ocw; }
+        else { rc.color_icw[0] = icw; rc.color_ocw[0] = ocw; }
+    }
+    if (final) { rc.final0 = inputs(0,0,0,input(12,0,0)); rc.final1 = input(12,1,0) << 8; }
+    return rc;
+}
+int main(void)
+{
+    unsigned texture, swapped, sum, final, i, k, checked = 0;
+    for (texture = 0; texture < 2; texture++) for (swapped = 0; swapped < 2; swapped++)
+    for (sum = 0; sum < 2; sum++) for (final = 0; final < 2; final++) {
+        Nv2aCombiner rc = program(texture, swapped, sum, final);
+        assert(nv2a_rc_shade_mode(&rc) == (texture ? NV2A_SHADE_MODULATE : NV2A_SHADE_DIFFUSE));
+        for (i = 0; i < 65; i++) {
+            float v0[4], v1[4], fog[4], t[4][4], out[4];
+            for (k = 0; k < 4; k++) {
+                v0[k] = (float)((i * (17 + 2*k)) % 257) / 64 - 1.5f;
+                v1[k] = .37f; fog[k] = .83f;
+                t[0][k] = (float)((i * (31 + 2*k) + k) % 257) / 256;
+                t[1][k] = .23f; t[2][k] = .49f; t[3][k] = .91f;
+            }
+            nv2a_rc_eval(&rc, v0, v1, fog, (const float (*)[4])t, out);
+            for (k = 0; k < 4; k++) {
+                float expected = fmaxf(v0[k],0) * (texture ? t[0][k] : 1);
+                expected = fminf(expected,1);
+                assert(fabsf(out[k] - expected) < 1e-6f);
+            }
+            checked++;
+        }
+        rc.factor0[0] = 0xA137C95Bu; rc.factor1[0] = 0x23F78149u;
+        rc.final_c0 = 0x37A9C15Bu; rc.final_c1 = 0xF193275Du;
+        rc.final1 |= final ? 0xE0 : 0;
+        assert(nv2a_rc_shade_mode(&rc) == (texture ? NV2A_SHADE_MODULATE : NV2A_SHADE_DIFFUSE));
