+/* mcpx_apu_phys_span(a) vouches for n bytes: each must resolve as
+ * mcpx_apu_phys does, within a's page. Checked from every step-th address
+ * in [lo, hi). */
+static int spans_ok(uint32_t lo, uint32_t hi, uint32_t step)
+{
+    for (uint32_t a = lo; a < hi; a += step) {
+        uint32_t n = 0;
+        uint8_t *p = mcpx_apu_phys_span(a, &n);
+        if (p != mcpx_apu_phys(a) || n == 0 || (a & 0xFFFu) + n > 0x1000u) {
+            printf("  span at 0x%08X: %u bytes\n", a, n);
+            return 0;
+        }
+        for (uint32_t i = 0; i < n; i++)
+            if (mcpx_apu_phys(a + i) != p + i) {
+                printf("  span at 0x%08X: byte %u of %u resolves elsewhere\n", a, i, n);
+                return 0;
+            }
+    }
+    return 1;
+}
+
+static void check_spans(const char *what, uint32_t a, uint32_t c)
+{
+    extern uint32_t xbox_ContiguousAllocatedBytes(void);
+    uint32_t top = xbox_ContiguousAllocatedBytes();
+    char line[96];
+    int ok = spans_ok(a - 0x2000u, c + 0x3000u, 0x35u) &&
+             spans_ok(g_xbox_image_lo - 0x1000u, g_xbox_image_lo + 0x1000u, 0x11u) &&
+             spans_ok(g_xbox_image_hi - 0x1000u, g_xbox_image_hi + 0x1000u, 0x11u) &&
+             spans_ok(top - 0x1000u, top + 0x1000u, 0x11u) &&
+             spans_ok((64u << 20) - 0x2000u, (64u << 20) + 0x2000u, 0x101u);
+    snprintf(line, sizeof line, "spans resolve as single addresses (%s)", what);
+    check(ok, line);
+}
