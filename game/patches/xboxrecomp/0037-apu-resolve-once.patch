+/* Sample data, resolved once per page instead of once per access.
+ *
+ * vp_fetch_data_addr is get_data_ptr with the SGE entry of the last linear
+ * page kept: the entry is read again only when the page changes. vp_fetch_host
+ * is mcpx_apu_phys with the last resolved span kept (mcpx_apu_phys_span):
+ * an address inside it is the span's host pointer plus the distance. Both
+ * give exactly what get_data_ptr and mcpx_apu_phys give. Nothing in
+ * voice_get_samples writes guest memory between its sample reads, so a kept
+ * SGE entry cannot go stale within one call. */
+typedef struct VpFetch {
+    hwaddr sge_base;
+    unsigned int sge_page;      /* linear page of sge_prd; ~0u: none */
+    uint32_t sge_prd;
+    hwaddr span_lo;             /* physical start of the resolved span */
+    uint32_t span_len;          /* its length; 0: none */
+    uint8_t *span_host;
+    bool once;                  /* false: every access resolved, as before */
+} VpFetch;
+
+static void vp_fetch_init(VpFetch *f, hwaddr sge_base)
+{
+    f->sge_base = sge_base;
+    f->sge_page = ~0u;
+    f->sge_prd = 0;
+    f->span_lo = 0;
+    f->span_len = 0;
+    f->span_host = NULL;
+    f->once = s_resolve_once != 0;
+}
+
+static inline uint8_t *vp_fetch_host(VpFetch *f, hwaddr addr)
+{
+    if (!f->once)
+        return mcpx_apu_phys(addr);
+    hwaddr off = addr - f->span_lo;
+    if (off < f->span_len)
+        return f->span_host + off;
+    f->span_host = mcpx_apu_phys_span(addr, &f->span_len);
+    f->span_lo = addr;
+    return f->span_host;
+}
+
+/* get_data_ptr(f->sge_base, 0xFFFFFFFF, addr), same arithmetic. */
+static inline hwaddr vp_fetch_data_addr(VpFetch *f, uint32_t addr)
+{
+    unsigned int entry = addr / TARGET_PAGE_SIZE;
+    if (entry != f->sge_page || !f->once) {
+        f->sge_prd = ldl_le_phys(address_space_memory,
+                                 f->sge_base + entry * 4 * 2);
+        f->sge_page = entry;
+    }
+    return f->sge_prd + addr % TARGET_PAGE_SIZE;
+}
