+/* mcpx_apu_phys(addr), plus in *avail how many bytes from addr on resolve
+ * the same way: for every 0 <= i < *avail, mcpx_apu_phys(addr + i) is the
+ * returned pointer + i. *avail is at least 1 and never runs past the end of
+ * addr's 4 KB page.
+ *
+ * Every case above is a fixed base plus a. Which case applies depends on the
+ * page maps, which hold one entry per 4 KB page, and on comparisons of a with
+ * 64 MB, the mapped RAM size, the image bounds and the contiguous arena's
+ * high-water mark. 64 MB is page aligned. The image bounds come from section
+ * sizes and need not be, so the span also stops at any of those bounds that
+ * falls inside the page. The voice processor uses this to resolve a voice's
+ * register block or a run of sample data once instead of per access. */
+uint8_t *mcpx_apu_phys_span(uint64_t addr, uint32_t *avail)
+{
+    uint32_t a = (uint32_t)addr & 0x0FFFFFFFu;
+    uint32_t end = (a | 0xFFFu) + 1u;
+    uint32_t bound[4];
+    bound[0] = g_xbox_image_lo;
+    bound[1] = g_xbox_image_hi;
+    bound[2] = xbox_ContiguousAllocatedBytes();
+    bound[3] = apu_mapped_ram();
+    for (int i = 0; i < 4; i++)
+        if (bound[i] > a && bound[i] < end)
+            end = bound[i];
+    *avail = end - a;
+    return mcpx_apu_phys(addr);
+}
