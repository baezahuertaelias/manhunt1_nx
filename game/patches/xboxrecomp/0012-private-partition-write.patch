 static char s_user_dir[MAX_PATH];   /* UDATA/TDATA/TitleCache root: s_save_dir or RECOMP_SAVE_DIR */
 static BOOL s_initialized = FALSE;
 
+/* The caller owns this freshly opened descriptor until immediate close. */
+static ssize_t write_partition_sector(int fd, const void *sector)
+{
+#if defined(__SWITCH__)
+    errno = 0;
+    if (lseek(fd, XBOX_PART_TABLE_OFFSET, SEEK_SET) < 0) {
+        if (!errno) errno = EIO;
+        return -1;
+    }
+    errno = 0;
+    ssize_t written = write(fd, sector, 512);
+    if (written < 512 && (written >= 0 || !errno)) errno = EIO;
+    return written;
+#else
+    return pwrite(fd, sector, 512, XBOX_PART_TABLE_OFFSET);
+#endif
+}
