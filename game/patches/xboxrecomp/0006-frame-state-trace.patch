+#!/usr/bin/env bash
+# Synthetic opt-in diagnostics check; no game inputs.
+set -euo pipefail
+[[ $# == 1 && -x "$1" ]] || { echo 'usage: check_trace.sh fixture-binary' >&2; exit 3; }
+binary="$(realpath -e "$1")"
+work="$(mktemp -d)"
+trap 'rm -rf "$work"' EXIT
+env -u RECOMP_FRAME_TRACE "$binary" >"$work/off.stdout" 2>"$work/off.stderr"
+touch "$work/trace.flag"
+RECOMP_FRAME_TRACE="$work/trace.flag" "$binary" >"$work/on.stdout" 2>"$work/on.stderr"
+cmp "$work/off.stdout" "$work/on.stdout"
+python3 - "$work/off.stderr" "$work/on.stderr" <<'PY'
+from pathlib import Path
+import collections
+import re
+import sys
+
+off, on = (Path(p).read_text() for p in sys.argv[1:])
+assert '[FTRACE]' not in off, 'trace output while disabled'
+records = collections.defaultdict(dict)
+for line in on.splitlines():
+    m = re.match(r'\[FTRACE\] (state|depth|surface|texture) draw=(\d+) (.*)', line)
+    if not m:
+        continue
+    kind, draw, payload = m.groups()
+    values = dict(re.findall(r'(\w+)=([^ ]+)', payload))
+    if kind == 'texture':
+        stage = int(values['stage'])
+        assert 0 <= stage < 4
+        key = (kind, stage)
+    else:
+        key = (kind,)
+    assert key not in records[draw], 'duplicate per-draw record'
+    records[draw][key] = values
+assert records, 'trace did not capture a batch'
+fields = {
+    'state': 'blend src dst eq constant alpha func ref mask cull face front',
+    'depth': 'test func write zeta min max min_raw max_raw stencil stencil_func stencil_ref compare_mask write_mask ops',
+    'surface': 'format_raw color_format zeta_format pitch_raw color_offset_raw zeta_offset_raw clip_h_raw clip_v_raw aa',
+    'texture': 'stage valid offset_raw va width height pitch format_raw format address_raw uv control0_raw control1_raw filter levels effective_levels rect_raw palette_raw palette_va palette_count_code palette_entries cube border_source border',
+}
+for draw, batch in records.items():
+    assert len(batch) == 7, (draw, 'expected state/depth/surface/four textures')
+    for kind, expected in fields.items():
+        for stage in range(4) if kind == 'texture' else [None]:
+            values = batch[(kind, stage) if stage is not None else (kind,)]
+            assert set(expected.split()) <= values.keys(), (draw, kind, 'missing fields')
+assert any(batch[('depth',)]['stencil'] == '1'
+           and batch[('depth',)]['stencil_func'] == '206'
+           and batch[('depth',)]['stencil_ref'] == '5'
+           and batch[('depth',)]['ops'].endswith('/1E02')
+           for batch in records.values()), 'written stencil state was not traced'
+assert any(batch[('surface',)]['format_raw'] == '00002008'
+           and batch[('surface',)]['aa'] == '2/2'
+           and batch[('surface',)]['pitch_raw'] == '00001400'
+           for batch in records.values()), 'raw AA surface state was not traced'
+assert any(batch[('texture', 0)]['palette_raw'] == '0000A004'
+           and batch[('texture', 0)]['palette_va'] == '0000A000'
+           and batch[('texture', 0)]['palette_count_code'] == '1'
+           and batch[('texture', 0)]['palette_entries'] == '128'
+           and batch[('texture', 0)]['format'] == '0B'
+           for batch in records.values()), 'raw 128-entry P8 descriptor was not traced'
+print(f'NV2A-FRAME-STATE-TRACE PASS batches={len(records)} off_on_stdout_equal=1')
+PY
