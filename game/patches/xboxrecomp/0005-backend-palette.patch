+/* shortcut: only primary/contiguous RAM views; expand after verified mirror use. */
+static int backend_ram_span(uint32_t va, uint64_t bytes)
+{
+    uint64_t end = (uint64_t)va + bytes;
+    return bytes && ((va && end <= 0x04000000ull)
+        || (va >= 0x80000000u && end <= 0x84000000ull));
+}
