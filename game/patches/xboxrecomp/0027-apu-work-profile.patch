 /* ============================================================
  * Globals
  * ============================================================ */
+
+/* Wall-time buckets in microseconds, enabled only with the perf report.
+ * IRQ includes guest ISR/DPC work delivered on this worker, not just mixing. */
+static uint64_t apu_perf[7];
+static int apu_perf_on(void)
+{
+    static int enabled = -1;
+    if (enabled < 0) {
+        const char *e = getenv("MANHUNT_PERF_LOG");
+        enabled = e && *e && *e != '0';
+    }
+    return enabled;
+}
+void mcpx_apu_perf_read(uint64_t out[7])
+{
+    for (int i = 0; i < 7; ++i)
+        out[i] = __atomic_load_n(&apu_perf[i], __ATOMIC_RELAXED);
+}
+static void apu_perf_add(int bucket, int64_t start)
+{
+    __atomic_fetch_add(&apu_perf[bucket],
+                       (uint64_t)(qemu_clock_get_us(QEMU_CLOCK_REALTIME) - start),
+                       __ATOMIC_RELAXED);
+}

