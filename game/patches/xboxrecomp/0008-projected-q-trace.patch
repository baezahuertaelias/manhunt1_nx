--- /dev/null
+++ b/src/kernel/nv2a_q_trace.h
@@ -0,0 +1,50 @@
+#ifndef NV2A_Q_TRACE_H
+#define NV2A_Q_TRACE_H
+#include <math.h>
+#include <stdint.h>
+
+typedef struct {
+    uint64_t accepted, triangles, vertices, one, zero, other, nonfinite_q, invalid_w, positive_w;
+    float min_q, max_q, min_w, max_w;
+    int have_finite, have_finite_w;
+} Nv2aQTrace;
+
+/* Inputs are the clipped vertices accepted by the CPU raster queue, not s_xf. */
+static inline void nv2a_q_trace_triangle(Nv2aQTrace *trace, int enabled, int projected,
+                                       const float q[3], const float w[3])
+{
+    if (!enabled) return;
+    trace->accepted++;
+    if (!projected) return;
+    trace->triangles++;
+    for (unsigned i = 0; i < 3; i++) {
+        trace->vertices++;
+        if (!isfinite(w[i]) || w[i] <= 0.0f) trace->invalid_w++;
+        else trace->positive_w++;
+        if (isfinite(w[i])) {
+            if (!trace->have_finite_w) {
+                trace->min_w = trace->max_w = w[i];
+                trace->have_finite_w = 1;
+            } else {
+                if (w[i] < trace->min_w) trace->min_w = w[i];
+                if (w[i] > trace->max_w) trace->max_w = w[i];
+            }
+        }
+        if (!isfinite(q[i])) { trace->nonfinite_q++; continue; }
+        if (!trace->have_finite) {
+            trace->min_q = trace->max_q = q[i];
+            trace->have_finite = 1;
+        } else {
+            if (q[i] < trace->min_q) trace->min_q = q[i];
+            if (q[i] > trace->max_q) trace->max_q = q[i];
+        }
+        if (q[i] == 1.0f) trace->one++;
+        else if (q[i] == 0.0f) trace->zero++;
+        else trace->other++;
+    }
+}
+static inline int nv2a_q_trace_all_one(const Nv2aQTrace *trace)
+{
+    return trace->vertices && trace->one == trace->vertices && !trace->invalid_w;
+}
+#endif
--- /dev/null
+++ b/tests/nv2a_ffp_backend/q_trace_test.c
@@ -0,0 +1,39 @@
+#undef NDEBUG
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "nv2a_q_trace.h"
+
+int main(void)
+{
+    Nv2aQTrace trace = {0}, empty = {0};
+    float q[3] = {1, 1, 1}, w[3] = {1, 2, 3};
+    nv2a_q_trace_triangle(&trace, 0, 1, q, w);
+    assert(!memcmp(&trace, &empty, sizeof trace));
+    assert(!nv2a_q_trace_all_one(&trace));
+    nv2a_q_trace_triangle(&trace, 1, 0, q, w);
+    assert(trace.accepted == 1 && trace.vertices == 0);
+    assert(!nv2a_q_trace_all_one(&trace));
+    nv2a_q_trace_triangle(&trace, 1, 1, q, w);
+    assert(trace.triangles == 1 && trace.vertices == 3 && trace.one == 3);
+    assert(nv2a_q_trace_all_one(&trace));
+    assert(trace.positive_w == 3 && trace.min_w == 1 && trace.max_w == 3);
+    q[1] = 2;
+    nv2a_q_trace_triangle(&trace, 1, 1, q, w);
+    assert(trace.vertices == 6 && trace.one == 5 && trace.other == 1);
+    assert(!nv2a_q_trace_all_one(&trace));
+    assert(trace.min_q == 1 && trace.max_q == 2);
+    q[0] = 0; q[1] = NAN; q[2] = -INFINITY;
+    w[0] = 0; w[1] = -1; w[2] = INFINITY;
+    nv2a_q_trace_triangle(&trace, 1, 1, q, w);
+    assert(trace.vertices == 3 * trace.triangles && trace.accepted == 4);
+    assert(trace.zero == 1 && trace.nonfinite_q == 2 && trace.invalid_w == 3);
+    assert(trace.min_q == 0 && trace.max_q == 2);
+    assert(trace.positive_w == 6 && trace.min_w == -1 && trace.max_w == 3);
+    memset(&trace, 0, sizeof trace);
+    q[0] = q[1] = q[2] = 1;
+    nv2a_q_trace_triangle(&trace, 1, 1, q, w);
+    assert(trace.one == 3 && !nv2a_q_trace_all_one(&trace));
+    puts("NV2A-PROJECTED-Q-HELPER PASS disabled/unobserved/later-vertex/zero/nonfinite/w/reset");
+    return 0;
+}
