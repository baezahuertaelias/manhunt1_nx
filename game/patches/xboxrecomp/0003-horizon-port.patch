+/* Horizon's open() cannot open a directory. A directory handle gets a real,
+ * closable fd from a placeholder file, and fstat on that fd answers for the
+ * directory it stands for. Enumeration already goes by the handle's path. */
+#define NX_DIRFD_MAX 1024
+static char *s_nx_dirfd[NX_DIRFD_MAX];
+static pthread_mutex_t s_nx_dirfd_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static int nx_open_dir(const char *path)
+{
+    struct stat st;
+    int fd;
+    if (stat(path, &st) != 0)
+        return -1;                             /* errno from stat */
+    if (!S_ISDIR(st.st_mode)) { errno = ENOTDIR; return -1; }
+    fd = open("sdmc:/.manhunt-dirfd", O_RDONLY | O_CREAT, 0644);
+    if (fd < 0)
+        return -1;
+    if (fd >= NX_DIRFD_MAX) {                  /* cannot record it: fail, never misreport */
+        close(fd);
+        errno = EMFILE;
+        return -1;
+    }
+    pthread_mutex_lock(&s_nx_dirfd_lock);
+    free(s_nx_dirfd[fd]);
+    s_nx_dirfd[fd] = strdup(path);
+    pthread_mutex_unlock(&s_nx_dirfd_lock);
+    return fd;
+}
+
+/* Called when a handle's fd is closed and when a regular open reuses a number. */
+static void nx_forget_fd(int fd)
+{
+    if (fd < 0 || fd >= NX_DIRFD_MAX)
+        return;
+    pthread_mutex_lock(&s_nx_dirfd_lock);
+    free(s_nx_dirfd[fd]);
+    s_nx_dirfd[fd] = NULL;
+    pthread_mutex_unlock(&s_nx_dirfd_lock);
+}
+
+static int nx_fstat(int fd, struct stat *st)
+{
+    char path[MAX_PATH] = "";
+    if (fd >= 0 && fd < NX_DIRFD_MAX) {
+        pthread_mutex_lock(&s_nx_dirfd_lock);
+        if (s_nx_dirfd[fd])
+            snprintf(path, sizeof path, "%s", s_nx_dirfd[fd]);
+        pthread_mutex_unlock(&s_nx_dirfd_lock);
+    }
+    if (path[0])
+        return stat(path, st);
+    return fstat(fd, st);
+}
+#define fstat(fd, st) nx_fstat((fd), (st))
+#endif
 #endif
 
