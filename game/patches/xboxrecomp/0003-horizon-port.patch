diff --git a/src/platform/win32_compat_horizon.inc b/src/platform/win32_compat_horizon.inc
new file mode 100644
index 0000000..e1bc2d9
--- /dev/null
+++ b/src/platform/win32_compat_horizon.inc
@@ -0,0 +1,253 @@
+/*
+ * Horizon (Nintendo Switch, libnx) backing for the Win32 virtual-memory
+ * vocabulary the runtime uses: VirtualAlloc/Free/Protect, CreateFileMapping,
+ * MapViewOfFile(Ex), UnmapViewOfFile. Included by win32_compat.c under
+ * __SWITCH__ in place of the mmap-based versions.
+ *
+ * Horizon has no mmap. What it offers (measured in Eden by the Manhunt
+ * project's tests/horizon-probe):
+ *   - address-space reservations (libnx virtmem), and
+ *   - code memory: a page-aligned heap buffer mapped read/write at a chosen
+ *     address with svcControlCodeMemory(MapOwner).
+ * Not available: a second read/write view of the same pages. So a file
+ * mapping gets one view; asking for another (the 64 MiB RAM mirrors) fails,
+ * and the memory layout reports fewer mirrors. Protection changes are
+ * accepted and ignored, and decommit keeps the pages.
+ */
+#include <switch.h>
+
+#define HZ_PAGE 0x1000u
+#define HZ_MAX_RES 64
+#define HZ_MAX_COMMIT 512
+
+typedef struct { uintptr_t base; size_t size; VirtmemReservation *rv; } hz_res;
+typedef struct { uintptr_t base; size_t size; void *src; Handle h; } hz_commit;
+
+static hz_res    s_res[HZ_MAX_RES];
+static hz_commit s_commit[HZ_MAX_COMMIT];
+static pthread_mutex_t s_hz_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static size_t hz_round(size_t n) { return (n + HZ_PAGE - 1) & ~(size_t)(HZ_PAGE - 1); }
+
+static int hz_unmapped(uintptr_t addr, size_t size)
+{
+    while (size) {
+        MemoryInfo mi;
+        u32 pi;
+        if (R_FAILED(svcQueryMemory(&mi, &pi, addr)) || mi.type != MemType_Unmapped)
+            return 0;
+        uintptr_t end = (uintptr_t)(mi.addr + mi.size);
+        if (end >= addr + size) return 1;
+        size -= end - addr;
+        addr = end;
+    }
+    return 1;
+}
+
+/* Back [addr, addr+size) with fresh zeroed memory. Caller holds the lock. */
+static void *hz_commit_at(uintptr_t addr, size_t size)
+{
+    int slot;
+    void *src;
+    Handle h;
+
+    size = hz_round(size);
+    for (slot = 0; slot < HZ_MAX_COMMIT && s_commit[slot].base; slot++) {}
+    if (slot == HZ_MAX_COMMIT || !hz_unmapped(addr, size))
+        return NULL;
+    src = aligned_alloc(HZ_PAGE, size);
+    if (!src)
+        return NULL;
+    memset(src, 0, size);
+    if (R_FAILED(svcCreateCodeMemory(&h, src, size))) {
+        free(src);
+        return NULL;
+    }
+    if (R_FAILED(svcControlCodeMemory(h, CodeMapOperation_MapOwner, (void *)addr, size, Perm_Rw))) {
+        svcCloseHandle(h);
+        free(src);
+        return NULL;
+    }
+    s_commit[slot] = (hz_commit){addr, size, src, h};
+    /* Zero the view itself: Eden presents an owner view as 0xFF-filled, not
+     * with the source buffer's contents (measured: device apertures read
+     * FFFFFFFF and XAPI spun on the USB controller's HcControl). Guest BSS and
+     * the "zeroed" apertures depend on this. */
+    memset((void *)addr, 0, size);
+    return (void *)addr;
+}
+
+/* Commit every unmapped page run inside [addr, addr+size). */
+static int hz_commit_range(uintptr_t addr, size_t size)
+{
+    uintptr_t end = addr + hz_round(size);
+    addr &= ~(uintptr_t)(HZ_PAGE - 1);
+    while (addr < end) {
+        MemoryInfo mi;
+        u32 pi;
+        if (R_FAILED(svcQueryMemory(&mi, &pi, addr)))
+            return 0;
+        uintptr_t run_end = (uintptr_t)(mi.addr + mi.size);
+        if (run_end > end) run_end = end;
+        if (mi.type == MemType_Unmapped && !hz_commit_at(addr, run_end - addr))
+            return 0;
+        addr = run_end;
+    }
+    return 1;
+}
+
+static void hz_uncommit(int slot)
+{
+    hz_commit *c = &s_commit[slot];
+    svcControlCodeMemory(c->h, CodeMapOperation_UnmapOwner, (void *)c->base, c->size, 0);
+    svcCloseHandle(c->h);
+    free(c->src);
+    memset(c, 0, sizeof *c);
+}
+
+static uintptr_t hz_reserve(size_t size)
+{
+    int slot;
+    void *base;
+    VirtmemReservation *rv;
+
+    size = hz_round(size);
+    for (slot = 0; slot < HZ_MAX_RES && s_res[slot].base; slot++) {}
+    if (slot == HZ_MAX_RES)
+        return 0;
+    virtmemLock();
+    base = virtmemFindAslr(size, 0x10000);
+    rv = base ? virtmemAddReservation(base, size) : NULL;
+    virtmemUnlock();
+    if (!rv)
+        return 0;
+    s_res[slot] = (hz_res){(uintptr_t)base, size, rv};
+    return (uintptr_t)base;
+}
+
+LPVOID VirtualAlloc(LPVOID address, SIZE_T size, DWORD allocationType, DWORD protect)
+{
+    uintptr_t base = (uintptr_t)address;
+    void *p = NULL;
+    (void)protect;
+
+    pthread_mutex_lock(&s_hz_lock);
+    if (!base) {
+        base = hz_reserve(size);
+        if (base && (allocationType & MEM_COMMIT))
+            p = hz_commit_at(base, size);
+        else if (base)
+            p = (void *)base;
+    } else if (allocationType & MEM_COMMIT) {
+        /* Fixed address: inside a reservation or not, back the pages. */
+        p = hz_commit_range(base, size) ? (void *)base : NULL;
+    } else {
+        p = hz_unmapped(base, hz_round(size)) ? (void *)base : NULL;
+    }
+    pthread_mutex_unlock(&s_hz_lock);
+    if (!p)
+        SetLastError(ERROR_NOT_ENOUGH_MEMORY);
+    return p;
+}
+
+BOOL VirtualFree(LPVOID address, SIZE_T size, DWORD freeType)
+{
+    uintptr_t a = (uintptr_t)address;
+    int i;
+    (void)size;
+
+    if (!(freeType & MEM_RELEASE))
+        return TRUE;                        /* MEM_DECOMMIT: pages stay */
+    pthread_mutex_lock(&s_hz_lock);
+    for (i = 0; i < HZ_MAX_COMMIT; i++)
+        if (s_commit[i].base == a) {
+            hz_uncommit(i);
+            break;
+        }
+    for (i = 0; i < HZ_MAX_RES; i++)
+        if (s_res[i].base == a && size == 0) {   /* whole reservation */
+            virtmemLock();
+            virtmemRemoveReservation(s_res[i].rv);
+            virtmemUnlock();
+            memset(&s_res[i], 0, sizeof s_res[i]);
+            break;
+        }
+    /* A partial release of a reservation (the layout frees the first 64 MiB
+     * of its span to place the RAM view there) needs nothing: a reservation
+     * has no backing, and the view is committed at that address next. */
+    pthread_mutex_unlock(&s_hz_lock);
+    return TRUE;
+}
+
+BOOL VirtualProtect(LPVOID address, SIZE_T size, DWORD newProtect, PDWORD oldProtect)
+{
+    (void)address; (void)size; (void)newProtect;
+    if (oldProtect) *oldProtect = PAGE_READWRITE;
+    return TRUE;                            /* no per-page protection here */
+}
+
+HANDLE CreateFileMappingA(HANDLE file, LPSECURITY_ATTRIBUTES sa, DWORD protect,
+                          DWORD maxSizeHigh, DWORD maxSizeLow, LPCSTR name)
+{
+    (void)file; (void)sa; (void)protect; (void)name;
+    SIZE_T size = ((SIZE_T)maxSizeHigh << 32) | maxSizeLow;
+    if (size == 0) { SetLastError(ERROR_INVALID_PARAMETER); return NULL; }
+    w32_object *o = obj_alloc(K_FILEMAP);
+    o->fd       = -1;
+    o->map_size = size;
+    o->map_view = NULL;
+    return (HANDLE)o;
+}
+
+HANDLE CreateFileMappingW(HANDLE file, LPSECURITY_ATTRIBUTES sa, DWORD protect,
+                          DWORD maxSizeHigh, DWORD maxSizeLow, LPCWSTR name)
+{
+    (void)name;
+    return CreateFileMappingA(file, sa, protect, maxSizeHigh, maxSizeLow, NULL);
+}
+
+LPVOID MapViewOfFileEx(HANDLE mapping, DWORD access, DWORD offHigh, DWORD offLow,
+                       SIZE_T count, LPVOID baseAddr)
+{
+    w32_object *o = (w32_object *)mapping;
+    void *p;
+    (void)access;
+
+    if (!o || o->kind != K_FILEMAP) { SetLastError(ERROR_INVALID_HANDLE); return NULL; }
+    if (offHigh || offLow || o->map_view) {
+        /* A second view of the same pages (a mirror) or an offset view:
+         * Horizon cannot alias read/write memory. */
+        SetLastError(ERROR_NOT_SUPPORTED);
+        return NULL;
+    }
+    SIZE_T len = count ? count : o->map_size;
+    pthread_mutex_lock(&s_hz_lock);
+    if (baseAddr)
+        p = hz_commit_at((uintptr_t)baseAddr, len);
+    else {
+        uintptr_t b = hz_reserve(len);
+        p = b ? hz_commit_at(b, len) : NULL;
+    }
+    pthread_mutex_unlock(&s_hz_lock);
+    if (!p) { SetLastError(ERROR_NOT_ENOUGH_MEMORY); return NULL; }
+    o->map_view = p;
+    return p;
+}
+
+LPVOID MapViewOfFile(HANDLE mapping, DWORD access, DWORD offHigh, DWORD offLow, SIZE_T count)
+{
+    return MapViewOfFileEx(mapping, access, offHigh, offLow, count, NULL);
+}
+
+BOOL UnmapViewOfFile(LPCVOID baseAddr)
+{
+    int i;
+    pthread_mutex_lock(&s_hz_lock);
+    for (i = 0; i < HZ_MAX_COMMIT; i++)
+        if (s_commit[i].base == (uintptr_t)baseAddr) {
+            hz_uncommit(i);
+            break;
+        }
+    pthread_mutex_unlock(&s_hz_lock);
+    return i < HZ_MAX_COMMIT;
+}
