--- a/src/kernel/kernel_bridge.c
+++ b/src/kernel/kernel_bridge.c
@@ -1939,9 +1939,29 @@
 }
 
 /* ── KeQuerySystemTime (ordinal 128) ─────────────────────── */
+#if defined(__SWITCH__)
+#include <time.h>   /* nanosleep, struct timespec (patch 0017) */
+#endif
 static void bridge_KeQuerySystemTime(void)
 {
     uint32_t time_ptr = STACK_ARG(0);
+#if defined(__SWITCH__)
+    /* Patch 0017. A title waiting on the clock polls this call millions of times a second (measured on
+     * the console: about 3.8 million per second, one core at 100%). Every 64th call sleeps briefly, BEFORE
+     * the time is read, so the value returned is current and the wait loop stops burning a core (heat,
+     * battery). How close to its deadline a wait now ends depends on the sleep granularity: NOT measured.
+     * RECOMP_TIME_YIELD=0 turns this off. */
+    static int yield_on = -1;
+    static unsigned long calls;
+    if (yield_on < 0) {
+        const char *e = getenv("RECOMP_TIME_YIELD");
+        yield_on = !(e && *e == '0');
+    }
+    if (yield_on && (++calls & 63u) == 0) {
+        struct timespec ts = {0, 20000};
+        nanosleep(&ts, NULL);
+    }
+#endif
     xbox_KeQuerySystemTime(XBOX_TO_NATIVE(time_ptr));
     g_eax = 0;
 }
