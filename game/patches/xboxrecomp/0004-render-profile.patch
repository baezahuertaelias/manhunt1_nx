+#ifndef NV2A_PROFILE_H
+#define NV2A_PROFILE_H
+#include <stdint.h>
+#include <stdio.h>
+#include "platform/host_time.h"
+
+enum { NV_PROFILE_SCAN, NV_PROFILE_METHOD, NV_PROFILE_DRAW,
+       NV_PROFILE_CLEAR, NV_PROFILE_PRESENT, NV_PROFILE_TRIANGLE, NV_PROFILE_COUNT };
+typedef struct {
+    uint64_t ns[NV_PROFILE_COUNT], calls[NV_PROFILE_COUNT];
+    uint64_t invalid, first_ns, last_flip_ns, flip_ns, flips;
+    int have_flip;
+} Nv2aProfile;
+extern _Thread_local Nv2aProfile nv2a_profile;
+int nv2a_profile_enabled(void);
+
+typedef struct { uint64_t ns; int active; } Nv2aProfileStart;
+static inline Nv2aProfileStart nv2a_profile_begin(void)
+{
+    Nv2aProfileStart start = {0, nv2a_profile_enabled()};
+    if (start.active) start.ns = xbox_HostNowNs();
+    return start;
+}
+static inline void nv2a_profile_end(unsigned scope, Nv2aProfileStart start)
+{
+    if (!start.active) return;
+    uint64_t end = xbox_HostNowNs();
+    if (end < start.ns) { nv2a_profile.invalid++; return; }
+    nv2a_profile.ns[scope] += end - start.ns;
+    nv2a_profile.calls[scope]++;
+}
+static inline void nv2a_profile_flip(uint64_t now)
+{
+    if (!nv2a_profile_enabled()) return;
+    if (nv2a_profile.have_flip) {
+        if (now < nv2a_profile.last_flip_ns) { nv2a_profile.invalid++; return; }
+        else { nv2a_profile.flip_ns += now - nv2a_profile.last_flip_ns;
+               nv2a_profile.flips++; }
+    } else { nv2a_profile.first_ns = now; nv2a_profile.have_flip = 1; }
+    nv2a_profile.last_flip_ns = now;
+}
+/* Inclusive scopes overlap. This difference is scanner overhead, never guest time. */
+static inline int nv2a_profile_scan_only(uint64_t *ns)
+{
+    if (nv2a_profile.ns[NV_PROFILE_METHOD] > nv2a_profile.ns[NV_PROFILE_SCAN])
+        return 0;
+    *ns = nv2a_profile.ns[NV_PROFILE_SCAN] - nv2a_profile.ns[NV_PROFILE_METHOD];
+    return 1;
+}
+static inline void nv2a_profile_report(void)
+{
+    static const char *names[] = {"scan", "method", "draw", "clear", "present", "raster"};
+    if (!nv2a_profile_enabled()) return;
+    fprintf(stderr, "[RENDER-PROFILE] thread_local cumulative inclusive wall_ns invalid=%llu\n",
+            (unsigned long long)nv2a_profile.invalid);
+    for (unsigned i = 0; i < NV_PROFILE_COUNT; i++)
+        fprintf(stderr, "[RENDER-PROFILE] %s calls=%llu ns=%llu\n", names[i],
+                (unsigned long long)nv2a_profile.calls[i],
+                (unsigned long long)nv2a_profile.ns[i]);
+    uint64_t scan_only;
+    if (nv2a_profile_scan_only(&scan_only))
+        fprintf(stderr, "[RENDER-PROFILE] scan_excluding_methods_ns=%llu\n",
+                (unsigned long long)scan_only);
+    else fprintf(stderr, "[RENDER-PROFILE] scan_excluding_methods_ns=UNVERIFIED\n");
+    fprintf(stderr, "[RENDER-PROFILE] flip_intervals=%llu ns=%llu first_ns=%llu last_ns=%llu\n",
+            (unsigned long long)nv2a_profile.flips,
+            (unsigned long long)nv2a_profile.flip_ns,
+            (unsigned long long)nv2a_profile.first_ns,
+            (unsigned long long)nv2a_profile.last_flip_ns);
+}
+#endif
