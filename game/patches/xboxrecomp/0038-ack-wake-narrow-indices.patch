+/*
+ * nv2a_ack_wake.h - let the NV2A ack loop sleep while the GPU is idle.
+ *
+ * The ack loop (xbox_memory_layout.c) executes the pushbuffer, advances
+ * DMA_GET, answers the PFB flush kick and runs a handful of clocks. It used
+ * to pass every 200 us whether or not anything had been submitted: about
+ * 5000 wake-ups a second on a console whose three usable cores are already
+ * busy. Now, once a pass finds nothing pending (GET == PUT, no flip held, no
+ * flush kick waiting), it sleeps on an event for up to a millisecond, and the
+ * title's KickOff (game/src/d3d_kickoff.c) sets the event when it writes PUT.
+ * While work is pending the loop keeps its 200 us cadence.
+ *
+ * The handshake is the usual one for "sleep unless there is work":
+ *
+ *   loop:    sleeping = 1; full fence; if (!pending()) wait(event, ms);
+ *            sleeping = 0
+ *   kicker:  publish PUT; full fence; if (sleeping) signal(event)
+ *
+ * Either the loop sees the new PUT in its re-check, or the kicker sees
+ * sleeping and signals. The event is sticky (auto-reset), so a signal sent
+ * before the wait starts is not lost: the wait returns at once. A stale
+ * signal costs one early pass.
+ *
+ * The event itself is supplied by the caller (signal/wait callbacks), so
+ * tests/nv2a-ack-wake in the game project drives this with pthreads and no
+ * kernel.
+ */
+#ifndef NV2A_ACK_WAKE_H
+#define NV2A_ACK_WAKE_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct XboxAckWake {
+    volatile int sleeping;          /* the loop is about to wait or waiting */
+    void *event;                    /* NULL: waking is off */
+    void (*signal)(void *event);
+    /* Wait up to ms; 1 when signalled, 0 on timeout. */
+    int  (*wait)(void *event, unsigned ms);
+    /* Statistics, written by the loop only. */
+    uint32_t kick_wakes, timeouts, skipped;
+} XboxAckWake;
+
+/* Kicker side, right after the new PUT is stored. */
+static inline void xbox_AckWakeKick(XboxAckWake *w)
+{
+    if (!w->event)
+        return;
+    __atomic_thread_fence(__ATOMIC_SEQ_CST);
+    if (__atomic_load_n(&w->sleeping, __ATOMIC_RELAXED))
+        w->signal(w->event);
+}
+
+/* Loop side, at the end of a pass that found nothing to do. pending(arg) is
+ * evaluated again after the loop has announced the sleep; when it reports
+ * work the loop does not wait. Returns 1 woken, 0 timed out, -1 not slept. */
+static inline int xbox_AckWakeIdle(XboxAckWake *w, int (*pending)(void *),
+                                   void *arg, unsigned ms)
+{
+    int r = -1;
+
+    __atomic_store_n(&w->sleeping, 1, __ATOMIC_SEQ_CST);
+    __atomic_thread_fence(__ATOMIC_SEQ_CST);
+    if (!pending(arg))
+        r = w->wait(w->event, ms);
+    __atomic_store_n(&w->sleeping, 0, __ATOMIC_RELEASE);
+    if (r > 0)
+        w->kick_wakes++;
+    else if (r == 0)
+        w->timeouts++;
+    else
+        w->skipped++;
+    return r;
+}
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* NV2A_ACK_WAKE_H */
