+/* Sleep while the GPU is idle, woken by the title's KickOff (nv2a_ack_wake.h).
+ *
+ * What the ack loop does each pass, and why a 1 ms idle sleep keeps each
+ * duty's timing:
+ *   - flip hold poll, PFB flush ack, DMA walk, GET advance: these only have
+ *     work while something is pending, and then the pass stays at 200 us
+ *     (nv2a_ack_pending); a KickOff wakes the loop as soon as PUT moves.
+ *   - interrupt-status clears and idle bits: nothing raises them here; the
+ *     vblank's two bits belong to the vblank-ack thread, and this loop is
+ *     only their backstop after VBL_ACK_LATE_MS.
+ *   - fence/counter mirrors, DSP ack, pokes: polled, up to 1 ms later when
+ *     idle.
+ *   - frame counters: 16 ms period. KeTickCount: GetTickCount, 1 ms unit.
+ *   - the MCPX counter moved once per pass; after a sleep it moves once per
+ *     200 us slept, so its rate stays what it was.
+ * MANHUNT_ACK_WAKE=0 restores the fixed 200 us pass. */
+#define NV2A_ACK_IDLE_MS  1u
+#define NV2A_ACK_PASS_NS  200000u
+static XboxAckWake g_nv2a_ack_wake;
+extern int nv2a_pb_exec_flip_held(void);
+extern uint64_t xbox_HostNowNs(void);
+
+static void nv2a_ack_signal(void *ev)
+{
+    SetEvent((HANDLE)ev);
+}
+
+static int nv2a_ack_wait(void *ev, unsigned ms)
+{
+    return WaitForSingleObject((HANDLE)ev, ms) == WAIT_OBJECT_0;
+}
+
+/* Work that wants the 200 us pass: a segment not yet executed (GET behind
+ * PUT), a flip held for its vblank, or a PFB flush kick waiting for its ack. */
+static int nv2a_ack_pending(void *param)
+{
+    const char *regs = (const char *)param;
+    uint32_t put = *(volatile const uint32_t *)(regs + NV2A_USER_DMA_PUT);
+    uint32_t get = *(volatile const uint32_t *)(regs + NV2A_USER_DMA_GET);
+
+    if (put != get || nv2a_pb_exec_flip_held())
+        return 1;
+    return (*(volatile const uint32_t *)(regs + NV2A_ACK_PFB_FLUSH) & 0x00010000u) != 0;
+}
+
+/* The title wrote DMA_PUT, or set the PFB flush kick: wake the loop if it is
+ * asleep. Any thread; a fence and a load when the loop is awake. */
+void xbox_Nv2aAckWake(void)
+{
+    xbox_AckWakeKick(&g_nv2a_ack_wake);
+}
