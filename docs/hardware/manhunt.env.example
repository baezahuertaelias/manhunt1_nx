# Copy to the SD card as sdmc:/switch/manhunt1_nx/manhunt.env (docs/MACOS_SWITCH_SETUP.md, section 3.3).
# KEY=VALUE per line. Do NOT add MANHUNT_PAD_SCRIPT: without it the real controller is read.

# Runtime log on the SD card (a console cannot show the debug channel). Must start with sdmc:/
MANHUNT_LOG_FILE=sdmc:/switch/manhunt1_nx/log.txt
# fsync after every log line so the last lines survive a console crash (slow; diagnostics only).
MANHUNT_LOG_SYNC=1
# Frame dump period in seconds (frames go to sdmc:/switch/manhunt1_nx/frames/).
MANHUNT_DUMP_SECS=5

# Needed on the console: hold the whole 4 GB guest window as one reservation so the NV2A/MCPX/flash
# aperture windows do not land in the libnx heap (patch 0015; reports/HW_SWITCH_FIRST_RUN.md).
RECOMP_SPAN_4G=1

# Optional, all default off:
# Stream the log to a listener on the PC (run "nc -l 5555" there): independent of the SD card.
# MANHUNT_LOG_TCP=<PC ip>:5555
# Lock-free watchdog thread writing wd.txt (progress tick, memory use) next to the log.
# MANHUNT_WD=1
# Native deko3d GPU path (other draws fall back to the CPU renderer). On one console, 2026-11-04: about
# 28.85 flips per second on the menu, about 0.19 in the first mission, no crash line; gameplay UNVERIFIED
# (reports/HW_DEKO_ADAPTER_RUNS.md). If you try it and the console stalls, remove the line.
# MANHUNT_GPU_BACKEND=1
# Adapter check, slow: every call also runs through the conservative path and is compared.
# MANHUNT_DEKO_VERIFY=1
# Experimental: keep the render target on the GPU across calls. Off by default because of a known gap
# that verify cannot observe (docs/CONFIGURATION.md). Needs MANHUNT_GPU_BACKEND=1.
# MANHUNT_DEKO_RESIDENT=1
# Experimental, in every Switch build: sleep in the guest's time-polling loop. It changes guest timing,
# so it is off by default until that is measured.
# RECOMP_TIME_YIELD=1
# Do NOT set RECOMP_WATCHDOG_SECS in normal runs: it ends the process (_exit) after that many seconds.
