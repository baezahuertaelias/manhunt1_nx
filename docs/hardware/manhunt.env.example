# Copy to the SD card as sdmc:/manhunt.env (see docs/MACOS_SWITCH_SETUP.md, section 3.3).
# KEY=VALUE per line. Do NOT add MANHUNT_PAD_SCRIPT: without it the real controller is read.
# Frame dump period in seconds (frames go to sdmc:/manhunt-frames/).
MANHUNT_DUMP_SECS=5
# Native deko3d path, the same as every Eden run. If the console shows corruption or stalls,
# remove this line once (CPU software path) and report both results.
MANHUNT_GPU_BACKEND=1
# Write the runtime log to the SD card (a console cannot show the debug channel). Must start with sdmc:/
MANHUNT_LOG_FILE=sdmc:/manhunt-log.txt
# Periodic pushbuffer report and read-only player-object peeks (printed into that log).
RECOMP_PB_REPORT_MS=10000
RECOMP_PEEK=0x4004A0
RECOMP_PEEK_CHAIN=0x4004A0,0x80,4,0x40
